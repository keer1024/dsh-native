# Publishing target: GitHub Packages. The scope mapping below is what makes
# `npm publish` (and `pnpm add @keer1024/dsh-native`) resolve to GitHub instead of
# the public registry — it works *without* publishConfig.registry, which would
# otherwise pin the target and silently override `--registry`.
@keer1024:registry=https://npm.pkg.github.com

# The token is never committed: export NODE_AUTH_TOKEN before publishing, or let
# actions/setup-node write this line from the `NODE_AUTH_TOKEN` secret in CI.
# //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# To publish the same tarball to the public registry instead, override the scope key
# for one invocation (a bare `--registry` is not enough for a scoped package):
#   npm publish --@keer1024:registry=https://registry.npmjs.org
