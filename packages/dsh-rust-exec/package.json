{
  "name": "dsh-native",
  "version": "1.7.1",
  "type": "module",
  "main": "./index.js",
  "description": "dsh-native: resident Rust worker (lane pool, session affinity, soft RSS/CPU limits) for command execution, sha256-guarded file IO, code indexing and search, session-log projection and resource sampling; host-side JSON-RPC middleware with 8 HTTP routes, plus a pinned projection view, a Grafana-style monitor and the R-Native status strip.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-native",
    "rust",
    "sidecar",
    "powershell",
    "code-index",
    "session-projection"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/dsh-rust-worker.exe",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "pack:check": "npm pack --dry-run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keer1024/dsh-native.git",
    "directory": "packages/dsh-rust-exec"
  },
  "homepage": "https://github.com/keer1024/dsh-native#readme",
  "bugs": {
    "url": "https://github.com/keer1024/dsh-native/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
